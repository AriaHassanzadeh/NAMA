# Local development only. Run: python scripts/setup_env.py
# Placeholders only; never commit the generated .env.
DJANGO_SECRET_KEY=CHANGE_ME_DJANGO_SECRET
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_DB=nama_analyze
POSTGRES_USER=nama
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Server-side only. Never use a NEXT_PUBLIC_ prefix.
BACKEND_ORIGIN=http://backend:8000

# Loopback-only port for the installed desktop pgAdmin.
DATABASE_PORT=5433

# Local verification emails are written to ignored backend/.local-emails/.
# Use django.core.mail.backends.smtp.EmailBackend for real inbox delivery.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL=NAMA Analyze <no-reply@nama.local>
ACCOUNT_VERIFICATION_ORIGIN=http://localhost:3000
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
