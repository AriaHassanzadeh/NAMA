# Local development only. Run: python scripts/setup_env.py
# Placeholders only; never commit the generated .env.
DJANGO_SECRET_KEY=CHANGE_ME_DJANGO_SECRET
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_DB=nama_analyze
POSTGRES_USER=nama
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Server-side only. Never use a NEXT_PUBLIC_ prefix.
BACKEND_ORIGIN=http://backend:8000

# Loopback-only port for the installed desktop pgAdmin.
DATABASE_PORT=5433
